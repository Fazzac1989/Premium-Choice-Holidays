# Copy to .env.local and fill in. .env.local is gitignored and must stay that
# way — the service role key below bypasses every RLS policy in the schema.
#
# Supabase → Project Settings → API for the first three.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Never import this into a client component, and never
# prefix it with NEXT_PUBLIC_. It is for the adapter, the assembly service and
# the confirmation path, which write records no user session may write.
SUPABASE_SERVICE_ROLE_KEY=

# mock | webbeds. Stays on mock until WebBeds certification is complete.
SUPPLIER_ADAPTER=mock

# WebBeds certification environment. Left blank while SUPPLIER_ADAPTER=mock.
WEBBEDS_API_URL=
WEBBEDS_USERNAME=
WEBBEDS_PASSWORD=
