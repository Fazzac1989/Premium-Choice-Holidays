# Line endings are LF in the repository, on every platform. Without this, a
# working copy created on Windows and one created on macOS produce whole-file
# diffs against each other.
* text=auto eol=lf

# Explicit for what this project actually contains.
*.sql    text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.js     text eol=lf
*.mjs    text eol=lf
*.cjs    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.css    text eol=lf
*.html   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.toml   text eol=lf
*.csv    text eol=lf

# Windows shells need CRLF or they misbehave.
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# Never touched, never diffed as text.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.pdf    binary
*.woff   binary
*.woff2  binary
*.ttf    binary

# Generated by `supabase gen types` — collapsed in GitHub diffs and excluded
# from language statistics, since it is output rather than source.
src/types/database.ts linguist-generated=true
