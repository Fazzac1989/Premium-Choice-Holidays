# artefacts turn up in the tree.
desktop.ini
Thumbs.db
ehthumbs.db
~$*
*.tmp
.DS_Store

# ------------------------------------------------------------------- IDEs ---
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
